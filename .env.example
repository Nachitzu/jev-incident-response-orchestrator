# Required for the LLM agents (detector / investigator / responder).
ANTHROPIC_API_KEY=

# Optional: enables live AbuseIPDB reputation lookups in the investigator.
# Leave blank to run fully offline against the bundled local threat intel.
ABUSEIPDB_API_KEY=

TYPESAFE_API_KEY=ts-...
TYPESAFE_DEFAULT_MODEL=jev-latest
SOAR_JEV_MODE=hybrid          # hybrid | jev-only | disabled
SOAR_FP_NOUL_THRESHOLD=0.25   # < 0.25 descarta el evento sin llamar a Claude
SOAR_HITL_CONFIDENCE_MIN=0.70 # < 0.70 fuerza revisión humana (HITL)

# Optional overrides (see docs/architecture.md).
# SOAR_MODEL=claude-sonnet-5
# SOAR_THINKING=auto
