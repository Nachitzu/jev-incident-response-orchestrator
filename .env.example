# Required for the LLM agents (detector / investigator / responder).
ANTHROPIC_API_KEY=

# LLM backend: anthropic (default) or deepseek. DeepSeek speaks the Anthropic
# Messages format at https://api.deepseek.com/anthropic, so the same client
# drives both; each provider routes its own (fast, reasoning) model pair.
SOAR_LLM_PROVIDER=anthropic

# Used when SOAR_LLM_PROVIDER=deepseek (fast -> deepseek-flash,
# reasoning -> deepseek-v4-pro). Never mix it with ANTHROPIC_API_KEY usage.
DEEPSEEK_API_KEY=
# Optional override of the DeepSeek Anthropic-compatible base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Optional: live AbuseIPDB reputation lookups for indicators missing from the
# bundled local threat intel. Leave blank to run fully offline.
ABUSEIPDB_API_KEY=

TYPESAFE_API_KEY=ts-...
SOAR_JEV_MODE=hybrid          # hybrid | jev-only | disabled
SOAR_FP_NOUL_THRESHOLD=0.25   # is_threat por debajo de esto descarta el evento sin llamar a Claude
SOAR_HITL_CONFIDENCE_MIN=0.70 # confianza de Score por debajo de esto fuerza revision humana (HITL)

# Optional: where the bundled intel/ATT&CK/playbook/scenario data lives.
# Defaults to the packaged copy, or the repo checkout when running from source.
# SOAR_DATA_DIR=/path/to/data
